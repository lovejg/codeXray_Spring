# 복사해서 .env 로 쓰세요: cp .env.example .env
# 소셜 로그인 클라이언트 ID (프론트에서 authorize URL 생성에 사용).
# 값이 비어 있으면 해당 소셜 로그인 버튼이 안내 alert 만 띄웁니다.
#
# client_secret 은 프론트에 두지 않습니다 — 백엔드 .env(GOOGLE_CLIENT_SECRET / NAVER_CLIENT_SECRET)에만.
# 각 콘솔의 승인된 리다이렉트 URI:
#   Google → http://localhost:5173/oauth/callback/google
#   Naver  → http://localhost:5173/oauth/callback/naver
VITE_GOOGLE_CLIENT_ID=
VITE_NAVER_CLIENT_ID=
