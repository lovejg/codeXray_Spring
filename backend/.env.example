# 복사해서 .env 로 쓰세요: cp .env.example .env
# ── DB (Postgres) ──
DB_URL=jdbc:postgresql://localhost:5432/codexray
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ──
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_EXPIRATION_MS=1800000
REFRESH_EXPIRATION_DAYS=14

# ── Mail ──
MAIL_MODE=console
MAIL_FROM=no-reply@codexray.local
APP_BASE_URL=http://localhost:5173

# ── Cookie ──
COOKIE_SECURE=false

# ── Admin ──
ADMIN_EMAIL=you@example.com
ADMIN_API_KEY=change-me-admin-key

# ── (나중 단계) ──
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
