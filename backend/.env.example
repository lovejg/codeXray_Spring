# 복사해서 .env 로 쓰세요: cp .env.example .env
# (.env 는 절대 커밋 금지 — 실제 시크릿 보관용. 배포 시엔 호스트 환경변수로 주입)

# ── DB (Postgres) ──
DB_URL=jdbc:postgresql://localhost:5432/codexray
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Kafka (AI 분석 비동기 처리) ──
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AI_JOBS_TOPIC=ai-jobs

# ── JWT ──
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_EXPIRATION_MS=1800000
REFRESH_EXPIRATION_DAYS=14

# ── Mail ──
# console = 콘솔에 링크만 출력(개발), smtp = 실제 발송
MAIL_MODE=console
MAIL_FROM=no-reply@codexray.local
# 인증 메일 링크의 베이스 주소. 배포 시 실제 프론트 도메인으로! (예: https://codexray.example.com)
APP_BASE_URL=http://localhost:5173

# 실제 발송하려면 MAIL_MODE=smtp 로 바꾸고 아래를 채우세요.
# Gmail: 2단계 인증 켠 뒤 '앱 비밀번호'(16자리) 발급 → SMTP_PASS 에 입력.
#        SMTP_USER 와 MAIL_FROM 은 본인 Gmail 주소로.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Cookie ──
# 배포(HTTPS)에선 true 로! (로컬 http 개발은 false)
COOKIE_SECURE=false

# ── CORS ──
# 프론트와 백엔드가 same-origin(리버스 프록시 등)이면 비워두세요.
# 다른 오리진(예: S3 프론트 + 별도 백엔드)이면 프론트 주소를 콤마로: https://codexray.example.com
APP_CORS_ORIGINS=

# ── Admin ──
ADMIN_EMAIL=you@example.com
ADMIN_API_KEY=change-me-admin-key

# ── AI (Anthropic Claude) ──
# 비워두면 AI 요청은 잡이 FAILED(AI_UNAVAILABLE) 처리됨. 앱은 정상 기동.
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=2

# ── OAuth (소셜 로그인) ──
# 비워두면 소셜 로그인만 동작 안 함(앱은 정상 기동). client-id 는 프론트 .env(VITE_*)에도 동일하게 필요.
# 승인된 리다이렉트 URI (각 콘솔 + 배포 도메인에도 등록해야 함):
#   Google → http://localhost:5173/oauth/callback/google  (Google Cloud Console)
#   Naver  → http://localhost:5173/oauth/callback/naver   (Naver Developers 앱 설정)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
