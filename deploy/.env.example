# 서버의 /srv/codexray/.env 모양. 서버에는 배포 작업이 GitHub Secrets/Variables 로 배포마다 새로 쓴다(.env 는 커밋 금지).
# 로컬에서 compose 로 띄워 볼 때: cp .env.example .env 후 값 채우기
# 비밀값은 길고 무작위로: openssl rand -hex 32

# 어떤 이미지를 띄울지. 비우면 로컬에서 build 한 codexray-backend:local, codexray-frontend:local
IMAGE_PREFIX=
IMAGE_TAG=

DB_USERNAME=codexray
DB_PASSWORD=
# HMAC-SHA 키라 32글자 이상
JWT_SECRET=
# 이 메일로 소셜 로그인해 처음 가입하는 계정이 관리자가 된다. 이미 가입한 계정이나 비밀번호 가입에는 붙지 않는다
ADMIN_EMAIL=

# 사이트 주소. 인증 메일 링크, 소셜 로그인 콜백의 앞부분. 예: https://codexray.org
APP_BASE_URL=

# 운영은 Resend SMTP(smtp.resend.com, 587, 사용자 resend, 비밀번호는 API 키)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# 비워도 앱은 뜬다(그 기능만 안 된다)
# 소셜 로그인 Client ID 는 GitHub 저장소 Variables, secret 은 production 환경 Secrets 에서 온다.
# 콘솔 콜백 주소는 APP_BASE_URL + /oauth/callback/google, /oauth/callback/naver
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 여기부터는 앱이 아니라 backup.sh 가 읽는다. Bandal 과 같은 R2 버킷을 쓰고 파일 이름 앞에 codexray/ 를 붙인다
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# healthchecks.io 의 감시 주소. 비우면 알리지 않는다
BACKUP_PING_URL=
