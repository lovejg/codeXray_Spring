# DB EC2 에서: cp .env.example .env  후 값 채우기 (.env 는 커밋 금지)

# Postgres 계정 — 강력한 비밀번호로! Main 의 backend .env 와 반드시 동일하게 맞춰야 함.
DB_USERNAME=codexray
DB_PASSWORD=change-me-to-a-strong-password

# 이 DB EC2 의 private IPv4 주소.
# AWS 콘솔 → EC2 → 인스턴스(DB) 선택 → 세부정보의 "프라이빗 IPv4 주소" 복사.
# (예: 10.0.1.23) — Kafka 가 Main 에게 알려줄 자기 주소로 사용됨.
DB_PRIVATE_IP=10.0.0.0
