# Main EC2 에서: cp .env.example .env  후 값 채우기 (.env 는 커밋 금지)
# 이 값들은 backend 컨테이너에 환경변수로 주입됨 → Spring 이 application.yml 의 ${...} 로 읽음.

# ── DB (DB EC2 의 private IP 로 접속. 계정/비번은 DB EC2 의 .env 와 반드시 동일) ──
DB_URL=jdbc:postgresql://172.31.0.161:5432/codexray
DB_USERNAME=codexray
DB_PASSWORD=change-me-same-as-db-ec2

# ── Redis / Kafka (역시 DB EC2 private IP) ──
REDIS_HOST=172.31.0.161
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=172.31.0.161:9092

# ── JWT (secret 은 최소 32글자 이상! 강력한 랜덤값으로) ──
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION_MS=1800000
REFRESH_EXPIRATION_DAYS=14

# ── 쿠키/메일/기본URL ──
COOKIE_SECURE=false                      # 지금은 http 라서 false (HTTPS 붙이면 true)
MAIL_MODE=console                        # 메일 발송 대신 콘솔 출력 (SMTP 아직 미설정)
MAIL_FROM=noreply@codexray.local
APP_BASE_URL=http://54.180.148.166       # Main 의 public IP (이메일 링크 등에 사용)
APP_CORS_ORIGINS=                        # 비움 = same-origin 전제 (nginx 프록시)

# ── 관리자 ──
ADMIN_EMAIL=admin@codexray.local
ADMIN_API_KEY=change-me-admin-key

# ── AI (선택: 비우면 앱은 뜨지만 AI 분석 호출 시 503) ──
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=2

# ── OAuth (선택: 지금 IP+http 라 소셜로그인 미사용 → 비워둠. HTTPS+도메인 후 채움) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
